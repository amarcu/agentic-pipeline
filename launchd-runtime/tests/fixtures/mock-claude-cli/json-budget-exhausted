#!/bin/bash
# Mock claude-cli hitting --max-budget-usd. The point of this fixture: the
# failure envelope is VALID JSON. Any capture logic that branches on "did it
# parse?" treats this as a healthy run and writes nothing to the log, so the
# failure Telegram arrives with a tail containing no failure.

if [[ "$1" == "--version" ]]; then
    echo "2.1.252 (Claude Code) [MOCK: json-budget-exhausted]"
    exit 0
fi

cat <<'JSON'
{"type":"result","subtype":"error_max_budget_usd","is_error":true,"num_turns":41,
 "total_cost_usd":5.0021,"session_id":"mock-session-budget",
 "terminal_reason":"budget_exhausted","api_error_status":null,
 "permission_denials":[],
 "result":"Run stopped: the $5.00 budget for this session was exhausted.",
 "modelUsage":{"claude-opus-4-8":{"inputTokens":1200,"outputTokens":8400,
  "cacheReadInputTokens":990000,"cacheCreationInputTokens":120000,
  "costUSD":5.0021,"contextWindow":1000000}}}
JSON
exit 1
