{
  "_comment": "Interactive / worker permission baseline. Merge into ~/.claude/settings.json with permissions/bin/merge-permissions.sh. This is the SOFT layer for trusted sessions on a machine you control: an unmatched command still prompts. It is NOT the anchor deny-net (anchor/targets/deny-baseline.json), which is the HARD layer for phone-driven remote sessions and must never be loosened with these allows.",
  "_removeFromAllow": [
    "Bash(rm *.log)",
    "Bash(rm -f *.log)"
  ],
  "_removeFromDeny": [
    "Bash(rm:*)",
    "Bash(cat *.env*)",
    "Bash(head *.env*)",
    "Bash(tail *.env*)",
    "Bash(less *.env*)",
    "Bash(more *.env*)"
  ],
  "permissions": {
