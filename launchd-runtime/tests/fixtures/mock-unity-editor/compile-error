#!/bin/bash
# Mock Unity editor. Exit codes and report shapes are the real editor's,
# measured under 6000.3.11f1: 0 passed, 2 a test failed, 1 no verdict.
OUT=""; LOGF=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -testResults) OUT="$2"; shift 2 ;;
        -logFile)     LOGF="$2"; shift 2 ;;
        *)            shift ;;
    esac
done

# A compile failure aborts before the runner, so no report is written.
cat > "$LOGF" <<'LOG'
Assets/Scripts/Tests/Foo.cs(40,24): error CS0246: The type or namespace name 'SectorData' could not be found
Assets/Scripts/Tests/Bar.cs(53,24): error CS0246: The type or namespace name 'SpawnPool' could not be found
Aborting batchmode due to failure:
Scripts have compiler errors.
LOG
exit 1
