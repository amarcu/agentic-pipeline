# Secrets for the runtime. Copy to launchd-runtime/secrets.env (git-ignored),
# fill in the values, and make it private:  chmod 600 launchd-runtime/secrets.env
#
# KEY=value, one per line. The file is parsed, never executed. A file that
# group or others can read is ignored, and the run log says so.

# The bot that sends the digests and alerts, and the chat it sends them to.
# Leave both out to keep them in the env block of ~/.claude/settings.json.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. Only bin/jev-route reads it (the shadow model-tier classifier).
TYPESAFE_API_KEY=
