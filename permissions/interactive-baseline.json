      "Bash(more */.env*)",
      "Bash(more .env*)",
      "Bash(more /*.env*)",
      "Bash(more ~/*.env*)",
      "Bash(rm * .git *)",
      "Bash(rm *.db)",
      "Bash(rm *.dump)",
      "Bash(rm *.env*)",
      "Bash(rm *.git)",
      "Bash(rm *.git/*)",
