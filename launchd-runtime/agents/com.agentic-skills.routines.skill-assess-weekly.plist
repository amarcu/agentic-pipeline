<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agentic-skills.routines.skill-assess-weekly</string>
    <key>ProgramArguments</key>
    <array>
        <string>__AGENTIC_HOME__/routines/_run.sh</string>
        <string>skill-assess-weekly</string>
    </array>
    <!-- Weekday 1 is Monday. 04:20 puts this after the 04:00 to 04:10 batch,
         so the tree it audits is the one last night's routines finished with,
         and inside the 03:55 pmset wake that already covers that batch. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>20</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__AGENTIC_HOME__/routines/logs/launchd-skill-assess-weekly.stdout</string>
    <key>StandardErrorPath</key>
    <string>__AGENTIC_HOME__/routines/logs/launchd-skill-assess-weekly.stderr</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
        <!-- The static suite is a second, and the judgement pass reads only
             the skills that moved. 15 minutes is generous for both. -->
        <key>ROUTINE_TIMEOUT_SECONDS</key>
        <string>900</string>
        <key>ROUTINE_CAPTURE_JSON</key>
        <string>1</string>
    </dict>
</dict>
</plist>
