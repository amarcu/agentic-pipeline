<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agentic-skills.routines.morning-proposals</string>
    <key>ProgramArguments</key>
    <array>
        <string>__AGENTIC_HOME__/routines/_run.sh</string>
        <string>morning-proposals</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>5</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__AGENTIC_HOME__/routines/logs/launchd-morning-proposals.stdout</string>
    <key>StandardErrorPath</key>
    <string>__AGENTIC_HOME__/routines/logs/launchd-morning-proposals.stderr</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>ROUTINE_CAPTURE_JSON</key>
        <string>1</string>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>ROUTINE_TIMEOUT_SECONDS</key>
        <string>900</string>
    </dict>
</dict>
</plist>
